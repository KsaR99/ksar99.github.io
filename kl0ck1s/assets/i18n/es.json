    "modes": {
        "marathon": {
            "name": "Maratón",
            "description": "Juego clásico sin fin",
            "rules": [
                "♾️ Juego infinito — despeja líneas y sube de nivel",
                "📈 La velocidad de caída aumenta con cada nivel",
                "🏆 Cuentan tanto la puntuación como el nivel más alto alcanzado"
            ]
        },
        "sprint": {
            "name": "Sprint",
            "description": "Completa 40 líneas lo más rápido posible",
            "rules": [
                "🎯 Objetivo: despejar 40 líneas",
                "⏱️ Tu tiempo es lo que cuenta — ve lo más rápido posible",
                "🚫 Una partida sin terminar no se guarda en la clasificación"
            ]
        },
        "ultra": {
            "name": "Ultra",
            "description": "La puntuación más alta en 3 minutos",
            "rules": [
                "⏱️ Tienes exactamente 3 minutos",
                "💯 Consigue la puntuación más alta posible antes de que se acabe el tiempo",
                "📊 Solo cuenta tu puntuación final"
            ]
        },
        "survival": {
            "name": "Supervivencia",
            "description": "Cuidado con las líneas ascendentes",
            "rules": [
                "🧱 Las líneas de basura suben constantemente desde abajo",
                "🕳️ Encuentra y aprovecha los huecos en la basura",
                "☠️ El juego termina cuando el tablero se llena"
            ]
        },
        "cheeseRace": {
            "name": "Carrera del queso",
            "description": "Excava una pila ya construida lo más rápido posible",
            "rules": [
                "🧀 El tablero empieza con 10 filas de basura con un hueco",
                "⏱️ Despéjalo todo lo más rápido posible",
                "🚫 Una partida sin terminar no se guarda en la clasificación"
            ]
        },
        "digSurvival": {
            "name": "Excavación de supervivencia",
            "description": "Excava sin parar - la basura vuelve a crecer en cuanto despejas una línea. Sobrevive y excava 100 líneas en total.",
            "rules": [
                "🧀 Empieza con una pequeña pila de basura abajo",
                "♻️ Cada línea que excavas vuelve a crecer al instante desde abajo - la pila nunca se acaba",
                "🎯 Excava un total de 100 líneas para ganar",
                "☠️ El juego termina cuando el tablero se llena"
            ]
        },
        "countdown": {
            "name": "Cuenta atrás",
            "description": "Limpia líneas para evitar que el reloj llegue a cero",
            "rules": [
                "⏱️ Empieza con 60 segundos en el reloj",
                "➕ Cada línea despejada añade tiempo (más por 4 líneas)",
                "⏳ El juego termina cuando el reloj llega a cero"
            ]
        },
        "random": {
            "name": "Aleatorio",
            "description": "Elige uno de los demás modos por ti al pulsar Iniciar",
            "rules": [
                "🎲 Elige al azar uno de los demás modos",
                "▶️ La partida se juega entonces exactamente como ese modo",
                "🔁 Elige Aleatorio de nuevo para otra sorpresa"
            ]
        }
    },
